generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Usertype {
  admin
  user
}

model User {
  id               String            @id @default(uuid())
  username         String?           @unique
  email            String            @unique
  password         String
  dateOfBirth      DateTime?         @map("date_of_birth") @db.Date
  isActivate       Boolean           @default(false) @map("is_activate")
  color            String?           @default("#000000")
  notification     Boolean           @default(true)
  userType         Usertype          @default(user)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  battlesAsUser1   Battle[]          @relation("User1Battles")
  battlesAsUser2   Battle[]          @relation("User2Battles")
  battlesWon       Battle[]          @relation("WinnerBattles")
  games            Games[]
  tokens           Token[]
  userCategories   UserCategory[]
  propriety        UserPropriety?
  userLevel        UserLevel?
  rankOffline      UserRankOffline[]
  rankOnline       UserRankOnline[]
  gameSessions     GameSession[]
  stat             UserStat?
  sentRequests     Friendship[]      @relation("SentRequests")
  receivedRequests Friendship[]      @relation("ReceivedRequests")
  sentInvites      BattleInvite[]    @relation("SentInvites")
  receivedInvites  BattleInvite[]    @relation("ReceivedInvites")

  @@map("user")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String           @map("sender_id")
  receiverId String           @map("receiver_id")
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  sender     User             @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User             @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friendship")
}

model BattleInvite {
  id         String       @id @default(uuid())
  senderId   String       @map("sender_id")
  receiverId String       @map("receiver_id")
  status     InviteStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  sender     User         @relation("SentInvites", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User         @relation("ReceivedInvites", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("battle_invite")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum Theme {
  TEAL
  ROSE
  BLUE
  FOREST
  EMERALD
  MINT
  AQUA
  CYAN
  SKY
  NAVY
  INDIGO
  VIOLET
  LAVENDER
  PLUM
  MAGENTA
  PINK
  CORAL
  PEACH
  SALMON
  RED
  CRIMSON
  BURGUNDY
  MAROON
  ORANGE
  AMBER
  GOLD
  YELLOW
  LIME
  OLIVE
  MOSS
  SAGE
  MINT_CREAM
  STONE
  SLATE
  GRAY
  CHARCOAL
  BLACK
  WHITE
  IVORY
  BEIGE
  SAND
  COCOA
  CHESTNUT
  RUST
  COPPER
  BRONZE
  SILVER
  PEARL
  OCEAN
  SUNSET
}

model GameSession {
  id           String                @id @default(uuid())
  userId       String                @map("user_id")
  difficulty   Difficulty?
  countryId    String?               @map("country_id")
  currentScore Int                   @default(0) @map("current_score")
  status       SessionStatus         @default(ACTIVE)
  createdAt    DateTime              @default(now()) @map("created_at")
  completedAt  DateTime?             @map("completed_at")
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions    GameSessionQuestion[]

  @@index([userId])
  @@map("game_session")
}

model GameSessionQuestion {
  id         String      @id @default(uuid())
  sessionId  String      @map("session_id")
  quizId     String      @map("quiz_id")
  order      Int
  isAnswered Boolean     @default(false) @map("is_answered")
  isCorrect  Boolean     @default(false) @map("is_correct")
  session    GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  quiz       Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("game_session_question")
}

model UserLevel {
  id               String  @id @default(uuid())
  userId           String  @unique @map("user_id")
  xp               Int     @default(0)
  level            Int     @default(1)
  isBattleUnlocked Boolean @default(false) @map("is_battle_unlocked")
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_level")
}

model Otp {
  id        String   @id @default(uuid())
  email     String   @unique
  code      Int
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())

  @@map("otp")
}

model Token {
  id          String   @id @default(uuid())
  hashedToken String   @unique @map("hashed_token")
  userId      String   @unique @map("user_id")
  createdAt   DateTime @default(now())
  expiresAt   DateTime @map("expires_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("token")
}

model UserPropriety {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  countryId String?  @map("country_id")
  level     Level    @default(Beginner)
  country   Country? @relation(fields: [countryId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_propriety")
}

model Country {
  id              String          @id @default(uuid())
  name            String          @unique
  flagIcon        String?         @map("flag_icon")
  continentId     String?         @map("continent_id")
  createdAt       DateTime        @default(now())
  quizzes         Quiz[]
  games           Games[]
  userProprieties UserPropriety[]
  continent       Continent?      @relation(fields: [continentId], references: [id])

  @@index([continentId])
  @@map("country")
}

model Continent {
  id        String    @id @default(uuid())
  name      String    @unique
  countries Country[]

  @@map("continent")
}

model Category {
  id             String         @id @default(uuid())
  incid          Int            @unique @default(autoincrement())
  name           String         @unique
  icon           String?
  description    String?
  theme        Theme          @default(TEAL)
  games          Games[]
  quizzes        Quiz[]
  userCategories UserCategory[]

  @@map("category")
}

model UserCategory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  categoryId   String   @map("category_id")
  score        Int      @default(0)
  matchsPlayed Int      @default(0) @map("matchs_played")
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
  @@map("user_categories")
}

model Quiz {
  id               String                @id @default(uuid())
  categoryId       String                @map("category_id")
  countryId        String?               @map("country_id")
  difficulty       Difficulty            @default(Easy)
  question         String
  answer           String
  suggestedAnswer  Json?                 @map("suggested_answer")
  category         Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  country          Country?              @relation(fields: [countryId], references: [id])
  sessionQuestions GameSessionQuestion[]

  @@index([categoryId])
  @@index([countryId])
  @@map("quiz")
}

enum Difficulty {
  Easy
  Medium
  Hard
}

model Games {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  categoryId String?    @map("category_id")
  countryId  String?    @map("country_id")
  difficulty Difficulty
  score      Int        @default(0)
  playedAt   DateTime   @default(now()) @map("played_at")
  createdAt  DateTime   @default(now())
  category   Category?  @relation(fields: [categoryId], references: [id])
  country    Country?   @relation(fields: [countryId], references: [id])
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
  @@index([countryId])
  @@map("games")
}

model Battle {
  id            String    @id @default(uuid())
  user1Id       String    @map("user1_id")
  user2Id       String    @map("user2_id")
  battleStartAt DateTime  @default(now()) @map("battle_start_at")
  battleEndAt   DateTime? @map("battle_end_at")
  winnerId      String?   @map("winner_id")
  user1         User      @relation("User1Battles", fields: [user1Id], references: [id], onDelete: Cascade)
  user2         User      @relation("User2Battles", fields: [user2Id], references: [id], onDelete: Cascade)
  winner        User?     @relation("WinnerBattles", fields: [winnerId], references: [id])

  @@index([user1Id])
  @@index([user2Id])
  @@map("battle")
}

model UserStat {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stat")
}

model Ranked {
  id          String            @id @default(uuid())
  name        String            @unique
  minScore    Int               @map("min_score")
  maxScore    Int               @map("max_score")
  createdAt   DateTime          @default(now())
  rankOffline UserRankOffline[]
  rankOnline  UserRankOnline[]

  @@map("ranked")
}

model UserRankOnline {
  id     String @id @default(uuid())
  userId String @map("user_id")
  rankId String @map("rank_id")
  points Int    @default(0)
  rank   Ranked @relation(fields: [rankId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_rank_online")
}

model UserRankOffline {
  id     String @id @default(uuid())
  userId String @map("user_id")
  rankId String @map("rank_id")
  points Int    @default(0)
  rank   Ranked @relation(fields: [rankId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_rank_offline")
}

enum Level {
  Beginner
  Intermediate
  Expert
}
